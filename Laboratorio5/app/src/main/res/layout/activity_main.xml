<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Imagen de fondo que ocupa todo el ancho, centrada verticalmente -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_1" />

    <!-- Cuadro morado en la esquina superior izquierda (start) -->
    <View
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="start|top"
        android:background="#7B1FA2" />

    <!-- Cuadro morado centrado horizontalmente en la parte superior -->
    <View
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal|top"
        android:background="#7B1FA2" />

    <!-- Cuadro morado en la esquina superior derecha (end) -->
    <View
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="end|top"
        android:background="#7B1FA2" />

    <!-- Cuadro verde pequeño en la esquina superior izquierda (encima del morado) -->
    <View
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="start|top"
        android:background="#388E3C" />

    <!-- Imagen centrada encima de fondo_1 -->
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_2" />

</FrameLayout>